# Existing required settings
PORT=5000
MONGO_URI=mongodb+srv://...
JWT_SECRET=replace-with-a-secret

# Job Discovery refresh. Set one or both JSON arrays with employer-managed public boards.
# Greenhouse public Job Board API: https://boards-api.greenhouse.io/v1/boards/{boardToken}/jobs
JOB_GREENHOUSE_BOARDS=[{"boardToken":"your-company-board","company":"Your Company"}]
# Lever public Postings API: https://api.lever.co/v0/postings/{site}?mode=json
JOB_LEVER_SITES=[{"site":"your-company-site","company":"Your Company"}]

# Optional operational controls. The scheduler defaults to once every 24 hours.
JOB_REFRESH_ENABLED=true
JOB_REFRESH_INTERVAL_HOURS=24
JOB_REFRESH_RETRIES=2
# Only this existing authenticated account may call POST /api/jobs/refresh.
JOB_REFRESH_ADMIN_EMAIL=ops@example.com
